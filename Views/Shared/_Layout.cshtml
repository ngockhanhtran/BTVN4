<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Demo LAB</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Navbar -->
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
            <div class="container-fluid">
                <a class="navbar-brand text-light ms-3 fw-bold" asp-controller="Home" asp-action="Index">DEMO LAB</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-start ms-4">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link active fw-bold text-white" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" href="#">Giới thiệu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" href="#">Liên hệ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Product" asp-action="Index">Sản phẩm</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <div class="row">
            <!-- CỘT BÊN TRÁI -->
            <aside class="col-md-3">
                <!-- Load Partial View -->
                @await Html.PartialAsync("_CategoryPartial")

                <div class="mt-3 text-center">
                    <img src="~/images/banner-side.jpg" alt="Banner Quảng cáo" class="img-fluid border" />
                </div>
            </aside>

            <!-- CỘT BÊN PHẢI -->
            <main role="main" class="col-md-9">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="bg-dark text-white mt-5 p-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="text-uppercase fw-bold">GIỚI THIỆU</h5>
                    <p class="small text-white-50">
                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Debitis ab suscipit deserunt mollitia reiciendis, nobis iure aliquam velit et laboriosam ducimus veritatis corporis est.
                    </p>
                </div>
                <div class="col-md-6">
                    <h5 class="text-uppercase fw-bold">LIÊN HỆ</h5>
                    <p class="small text-white-50">
                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Odit amet suscipit quasi quisquam impedit magni molestias.
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>